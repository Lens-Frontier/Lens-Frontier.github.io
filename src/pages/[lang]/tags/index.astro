---
import RedirectLayout from '../../../layouts/RedirectLayout.astro';
import { languages, languageFrom, localizedPath } from '../../../lib/site';

export function getStaticPaths() {
	return languages.map((lang) => ({ params: { lang }, props: { lang } }));
}

const lang = languageFrom(Astro.props.lang);
---

<RedirectLayout
	to={localizedPath(lang, '/blog/tags/')}
	title={lang === 'zh' ? '研究主题' : 'Research topics'}
	{lang}
	alternatePath="/tags/"
/>
