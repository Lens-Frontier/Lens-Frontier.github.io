---
import RedirectLayout from '../../../layouts/RedirectLayout.astro';
import { languages, languageFrom, tagPath } from '../../../lib/site';
import { tagsForLanguage } from '../../../lib/content';

export async function getStaticPaths() {
	const tagSets = Object.fromEntries(
		await Promise.all(languages.map(async (lang) => [lang, new Set(await tagsForLanguage(lang))])),
	) as Record<(typeof languages)[number], Set<string>>;
	const paths = [];
	for (const lang of languages) {
		const tags = [...tagSets[lang]];
		paths.push(...tags.map((tag) => ({
			params: { lang, tag },
			props: {
				lang,
				tag,
				alternatePath: Object.fromEntries(languages.map((item) => [
					item,
					tagSets[item].has(tag) ? `/tags/${encodeURIComponent(tag)}/` : '/tags/',
				])),
			},
		})));
	}
	return paths;
}

const lang = languageFrom(Astro.props.lang);
const { tag, alternatePath } = Astro.props;
---

<RedirectLayout
	to={tagPath(tag, lang)}
	title={lang === 'zh' ? `研究主题：${tag}` : `Research topic: ${tag}`}
	{lang}
	{alternatePath}
/>
