const catalog = benchmarkCatalog(lang);
const categories = categoryLabels(lang);
const statuses = statusLabels(lang);
const evidence = evidenceLabels(lang);
const benchmarkPath = localizedPath(lang, '/benchmarks/');
const blogPath = localizedPath(lang, '/blog/');
const aboutPath = localizedPath(lang, '/about/');
const benchPath = (id: string) => localizedPath(lang, `/bench/${id}/`);
const dataCardPath = (id: string) => localizedPath(lang, `/bench/${id}/data/`);
const featuredCards = catalog.slice(0, 5);
const hasPublishedBenchmarks = catalog.length > 0;
const journalEntries = (await publishedEntries(lang)).slice(0, 4);
const researchTopicCount = new Set(journalEntries.flatMap(({ entry }) => entry.data.tags ?? [])).size;

