	alternatePath="/"
	title={copy.metaTitle}
	description={copy.metaDescription}
>
	<div class="observatory-home" data-observatory>
		<section class="obs-intro" aria-labelledby="obs-title">
			<div class="obs-intro__title">
				<span class="obs-kicker"><i aria-hidden="true"></i>{copy.kicker}</span>
				<h1 id="obs-title">{copy.title}</h1>
			</div>
			<div class="obs-intro__statement">
				<p>{copy.intro}</p>
				<a href={hasPublishedBenchmarks ? benchmarkPath : blogPath} class="obs-arrow-link">
					{hasPublishedBenchmarks ? copy.explore : copy.readBlog}<span aria-hidden="true">↗</span>
				</a>
				<div class="obs-release"><i aria-hidden="true"></i><span>{copy.preview}</span></div>
			</div>
		</section>

		{hasPublicResults ? <section id="leaderboard" class="chart-lab" aria-labelledby="chart-lab-title">
			<header class="chart-lab__compact-head">
				<div>
					<h2 id="chart-lab-title">{copy.chartCompactTitle}</h2>
					<p data-chart-view-note>{copy.chartCompactNote}</p>
				</div>
					{hasPublicResults && <div class="chart-lab__compact-actions">
						<div class="chart-lab__mode-switch" role="group" aria-label={lang === 'zh' ? '榜单模式' : 'Leaderboard mode'}>
							<button type="button" data-chart-mode="ranking" aria-pressed="true">{copy.singleRanking}</button>
							<button type="button" data-chart-mode="compare" aria-pressed="false">{copy.crossCompare}</button>
						</div>
						<button type="button" class="chart-lab__share" data-share-chart>{copy.shareImage}</button>
						<button type="button" data-filter-toggle aria-expanded="false" aria-controls="chart-filter-panel">
							<span data-filter-toggle-label>{copy.switchBenchmark}</span>
							<span class="chart-lab__filter-short">{lang === 'zh' ? '筛选' : 'Filters'}</span>
							<small><b data-filter-toggle-board-count>{publicBoardPayload.length}</b> Bench · <b data-filter-toggle-model-count>{initialVisibleLeaders.length}</b> {copy.modelUnit}</small>
					</button>
					</div>}
				</header>

				{hasPublicResults ? (<>
				<div id="chart-filter-panel" class="chart-lab__filter-popover" data-filter-panel hidden>
				<header><div><strong data-filter-title>{copy.filterTitle}</strong><small><b data-filter-panel-board-count>{publicBoardPayload.length}</b> Bench · <b data-filter-panel-model-count>{initialVisibleLeaders.length}</b> {copy.modelUnit}</small></div><button type="button" data-filter-close aria-label={lang === 'zh' ? '关闭筛选' : 'Close filters'}>×</button></header>
				<div class="chart-lab__filter-grid">
					<section>
						<div class="chart-lab__filter-section-title"><strong data-board-filter-title>{copy.benchFilters}</strong><div class="chart-lab__filter-presets"><button type="button" data-board-recommended>{copy.recommendedBenchmarks}</button><button type="button" data-board-all>{copy.allBenchmarks}</button><small data-board-selected-count>{publicBoardPayload.length}/{publicBoardPayload.length}</small></div></div>
						<label class="chart-lab__search"><span>{copy.benchSearch}</span><input type="search" data-board-search placeholder={copy.benchSearchPlaceholder} autocomplete="off" /></label>
						<div class="chart-lab__board-list" data-board-list>
							{publicBoardPayload.map((board) => (
								<label data-board-row={board.id} title={board.summary}>
									<input type="checkbox" value={board.id} data-board-pick checked />
									<span><strong>{board.name}</strong><small>{board.categoryLabel}</small></span>
									<em>{board.leaders.length} {copy.models}</em>
								</label>
							))}
						</div>
					</section>
					<section>
						<div class="chart-lab__filter-section-title"><strong>{copy.modelFilters}</strong><div class="chart-lab__filter-presets"><button type="button" data-filter-recommended>{copy.resetFilters}</button><button type="button" data-filter-all>{copy.allModels}</button><small data-model-selected-count>{initialVisibleLeaders.length}/{initialBoard?.leaders.length || 0}</small></div></div>
						<label class="chart-lab__search"><span>{copy.modelSearch}</span><input type="search" data-model-search placeholder={copy.modelSearchPlaceholder} autocomplete="off" /></label>
						<div class="chart-lab__model-list" data-model-list>
							{previewModels.map((item) => {
								const brand = modelBrand(item.model);
								return (
									<label data-model-row={item.model} title={`${copy.coverage} ${item.coverage}/${publicBoardPayload.length}`}>
										<input type="checkbox" value={item.model} data-model-check checked={initialDefaultModelNames.has(item.model)} />
										<span class="chart-lab__model-name">
											{brand && <img src={brand.icon} alt="" width="18" height="18" loading="lazy" aria-hidden="true" />}
											<strong>{item.model}</strong>
										</span>
										<small data-model-coverage>{item.coverage}/{publicBoardPayload.length}</small>
									</label>
								);
							})}
						</div>
					</section>
				</div>
			</div>

			<div class="chart-lab__stage chart-lab__stage--compact">
				<div class="chart-lab__bench-signal">
					<header>
						<div><span>{copy.benchmarkSignal}</span><strong data-active-board-signal>{initialBoard?.name}</strong></div>
						<small data-bench-signal-note>{copy.signalNote}</small>
					</header>
					<div class="chart-lab__selection-dock" data-compare-selection hidden>
						<div><span>{copy.selectedBenchmarks}</span><strong><b data-compare-selection-count>4</b>/6</strong></div>
						<div class="chart-lab__selection-list" data-compare-selection-list aria-live="polite"></div>
						<button type="button" data-compare-selection-reset>{copy.resetSelection}</button>
					</div>
					<div class="chart-lab__signal-list" data-bench-signal-list role="list" aria-label={copy.benchmarkSignal}>
						{featuredBoardPayload.map((board, index) => (
							<button
								type="button"
								role="listitem"
								data-bench-signal={board.id}
								data-board-name={board.name}
								aria-pressed={board.name === initialBoard?.name ? 'true' : 'false'}
								aria-label={`${board.name} · ${board.capability} · ${board.leaders.length} ${copy.evaluatedModels}`}
							>
								<span>{String(index + 1).padStart(2, '0')}</span>
								<strong>{board.name}</strong>
								<p>{board.capability}</p>
								<small><b>{board.leaders.length}</b><em>{copy.evaluatedModels}</em></small>
							</button>
						))}
					</div>
				</div>
				<div class="chart-lab__workspace">
					<div class="chart-lab__ranking-plot">
						<header><span><b data-ranking-title>{copy.rankedResults}</b><small data-ranking-note>{copy.scoreReading}</small></span><strong><b data-ranking-count>{initialVisibleLeaders.length}</b> <em data-ranking-unit>{copy.models}</em></strong></header>
						<div class="chart-lab__canvas" data-chart-canvas>
							<div data-leader-chart role="img" aria-label={copy.chartCompactTitle}></div>
							<p data-chart-empty hidden>{copy.noResult}</p>
						</div>
					</div>
				</div>
				<footer>
					<span>{copy.previewNote}</span>
					<div><a data-atlas-detail data-library-href={benchmarkPath} href={initialBoard?.href ?? benchmarkPath}><span data-detail-label>{copy.openBench}</span><span aria-hidden="true">↗</span></a></div>
					</footer>
				</div>
				</>) : (
					<div class="chart-lab__publication-empty">
						<span>{copy.noPublicResults}</span>
						<strong>{copy.awaitingTitle}</strong>
						<p>{copy.awaitingBody}</p>
						<div>
							<a href={blogPath}>{copy.awaitingCatalog}<span aria-hidden="true">↗</span></a>
							<a href={aboutPath}>{copy.awaitingSubmit}<span aria-hidden="true">↗</span></a>
						</div>
					</div>
				)}
			</section> : (
				<section id="leaderboard" class="obs-release-board" aria-labelledby="obs-release-title">
					<header>
						<span class="obs-kicker">{copy.releaseKicker}</span>
						<h2 id="obs-release-title">{copy.releaseTitle}</h2>
						<p>{copy.releaseBody}</p>
						<dl>
							<div><dt>{copy.publishedWriting}</dt><dd>{String(journalEntries.length).padStart(2, '0')}</dd></div>
							<div><dt>{copy.researchTopics}</dt><dd>{String(researchTopicCount).padStart(2, '0')}</dd></div>
						</dl>
					</header>
					<div class="obs-release-board__gates">
						<ol>
							{copy.releaseGates.map((gate, index) => (
								<li><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{gate.title}</strong><p>{gate.body}</p></div></li>
							))}
						</ol>
						<footer>
							<a href={blogPath}>{copy.browseResearch}<span aria-hidden="true">↗</span></a>
							<a href={aboutPath}>{copy.awaitingSubmit}<span aria-hidden="true">↗</span></a>
						</footer>
					</div>
				</section>
			)}

		{featuredCards.length > 0 && <section id="data-cards" class="obs-cards" aria-labelledby="obs-cards-title">
			<header class="obs-section-heading" data-obs-reveal>
				<span class="obs-kicker">{copy.cardsKicker}</span>
				<h2 id="obs-cards-title">{copy.cardsTitle}</h2>
				<p>{copy.cardsIntro}</p>
			</header>

			<div class="obs-card-index" data-obs-reveal>
				{featuredCards.map((card, index) => (
					<a href={dataCardPath(card.id)} class:list={{ 'is-featured': index === 0 }}>
						<header><span>{String(index + 1).padStart(2, '0')}</span><small>{statuses[card.status]}</small></header>
						<h3>{card.name}</h3>
						<p>{card.summary}</p>
						<dl>
							<div><dt>{copy.capability}</dt><dd>{card.capability}</dd></div>
							<div><dt>{copy.cardSource}</dt><dd>{card.source}</dd></div>
							<div><dt>{copy.judge}</dt><dd>{card.judgeMode}</dd></div>
						</dl>
						<footer><span>{categories[card.category]}</span><strong>{copy.openCard} ↗</strong></footer>
					</a>
				))}
			</div>
			{catalog.length > featuredCards.length && <a class="obs-arrow-link obs-cards__more" href={benchmarkPath}>{copy.allCards}<span aria-hidden="true">↗</span></a>}
		</section>}

		<section id="blog" class="obs-journal" aria-labelledby="obs-journal-title">
			<header class="obs-journal__head" data-obs-reveal>
				<div>
					<h2 id="obs-journal-title">{copy.journalTitle}</h2>
					<p>{copy.journalIntro}</p>
				</div>
				<a class="obs-arrow-link" href={blogPath}>{copy.allWriting}<span aria-hidden="true">↗</span></a>
			</header>
			{journalEntries.length ? (
				<div class="obs-journal__list" data-obs-reveal>
					{journalEntries.map(({ entry, collection }) => (
						<a href={entryPath(collection, entry.id, lang)}>
							<header>
								<span>{copy.journalCollections[collection]}</span>
								<time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US')}</time>
							</header>
							<h3>{entry.data.title}</h3>
							<p>{entry.data.summary}</p>
							<footer>
								<span>{entry.data.tags?.slice(0, 2).join(' · ')}</span>
								<strong>{copy.readEntry} ↗</strong>
							</footer>
						</a>
					))}
				</div>
			) : <p class="obs-journal__empty">{copy.journalEmpty}</p>}
		</section>

		<section id="insights" class="obs-method" aria-labelledby="obs-method-title">
			<div class="obs-method__statement" data-obs-reveal>
				<span class="obs-kicker">{copy.methodKicker}</span>
				<h2 id="obs-method-title">{copy.methodTitle}</h2>
				<p>{copy.methodIntro}</p>
				<a class="obs-arrow-link" href={blogPath}>{copy.research}<span aria-hidden="true">↗</span></a>
			</div>
			<ol class="obs-method__steps" data-obs-reveal>
				{copy.steps.map((step) => (
					<li><span>{step.no}</span><div><strong>{step.title}</strong><p>{step.body}</p></div></li>
				))}
			</ol>
		</section>

		{hasPublicResults && <>
		<script is:inline type="application/json" id="obs-board-data" set:html={JSON.stringify(boardPayload)}></script>
		<script is:inline type="application/json" id="obs-ui-copy" set:html={JSON.stringify({
			model: copy.model,
			average: copy.average,
			models: copy.models,
			publicBoards: copy.publicBoards,
			results: copy.results,
			noResult: copy.noResult,
			compareLimit: copy.compareLimit,
			selectedBenchmarks: copy.selectedBenchmarks,
			resetSelection: copy.resetSelection,
			removeBenchmark: copy.removeBenchmark,
			minimumCompareBenchmarks: copy.minimumCompareBenchmarks,
			compareBoardLimit: copy.compareBoardLimit,
			score: copy.score,
			rank: copy.rank,
			gap: copy.gap,
			evidence: copy.evidence,
			verified: copy.verified,
			reviewed: copy.reviewed,
			pending: copy.pending,
			distributionTitle: copy.distributionTitle,
			distributionNote: copy.distributionNote,
			rankingTitle: copy.rankingTitle,
			rankingNote: copy.rankingNote,
			comparisonTitle: copy.comparisonTitle,
			comparisonNote: copy.comparisonNote,
			visibleBenches: copy.visibleBenches,
			chartCompactTitle: copy.chartCompactTitle,
			chartCompactNote: copy.chartCompactNote,
			preview: copy.preview,
			benchmarkSignal: copy.benchmarkSignal,
			signalNote: copy.signalNote,
			rankedResults: copy.rankedResults,
			benchSummary: copy.benchSummary,
			zoomWindow: copy.zoomWindow,
			profileLabel: copy.profileLabel,
			matrixLabel: copy.matrixLabel,
			scoreSpan: copy.scoreSpan,
			scoreAxis: copy.scoreAxis,
			leaderScore: copy.leaderScore,
			verifiedResults: copy.verifiedResults,
			scored: copy.scored,
			coverage: copy.coverage,
				compareModels: copy.compareModels,
				focusedModel: copy.focusedModel,
			benchmark: copy.benchmark,
			noPublicResults: copy.noPublicResults,
			singleRanking: copy.singleRanking,
			crossCompare: copy.crossCompare,
			shareImage: copy.shareImage,
			sharingImage: copy.sharingImage,
			shareCopied: copy.shareCopied,
			shareDownloaded: copy.shareDownloaded,
			shareFailed: copy.shareFailed,
			switchBenchmark: copy.switchBenchmark,
			chooseComparison: copy.chooseComparison,
			filterTitle: copy.filterTitle,
			benchFilters: copy.benchFilters,
			modelFilters: copy.modelFilters,
			resetFilters: copy.resetFilters,
			allModels: copy.allModels,
			quickDefaultModels: copy.quickDefaultModels,
			recommendedBenchmarks: copy.recommendedBenchmarks,
			allBenchmarks: copy.allBenchmarks,
			quickModels: copy.quickModels,
			quickModelsHint: copy.quickModelsHint,
			allEvaluatedModels: copy.allEvaluatedModels,
			compareQuickModels: copy.compareQuickModels,
			compareQuickHint: copy.compareQuickHint,
			defaultCompareModels: copy.defaultCompareModels,
			refineSelection: copy.refineSelection,
			openLibrary: copy.openLibrary,
			openBench: copy.openBench,
			benchmarkUnit: copy.benchmarkUnit,
			modelUnit: copy.modelUnit,
			compareMaxGap: copy.compareMaxGap,
			compareCoverage: copy.compareCoverage,
			compareCaution: copy.compareCaution,
			compareBenchFilters: copy.compareBenchFilters,
			compareModelFilters: copy.compareModelFilters,
			scoreReading: copy.scoreReading,
			evaluatedModels: copy.evaluatedModels,
		})}></script>
		</>}
	</div>

	<script is:inline>
		(() => {
			const root = document.querySelector('[data-observatory]');
			if (!root) return;
			const nodes = [...root.querySelectorAll('[data-obs-reveal]')];
			const showAll = () => nodes.forEach((node) => node.classList.add('is-visible'));
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
				showAll();
				return;
			}
			const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				entry.target.classList.add('is-visible');
				observer.unobserve(entry.target);
			}), { rootMargin: '0px 0px 8% 0px', threshold: 0.08 });
			nodes.forEach((node) => observer.observe(node));
		})();
	</script>

	{hasPublicResults && <script>
		import '../../scripts/homeLeaderboard';
	</script>}
</BaseLayout>
