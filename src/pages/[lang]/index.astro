const boardPayload = catalog.map((asset) => ({
	id: asset.id,
	name: asset.name,
	category: asset.category,
	categoryLabel: categories[asset.category],
	status: asset.status,
	statusLabel: statuses[asset.status],
	capability: asset.capability,
	summary: asset.summary,
	source: asset.source,
	judge: asset.judgeMode,
	href: benchPath(asset.id),
	leaders: (asset.leaders ?? []).map((leader, index) => ({
		rank: index + 1,
		model: leader.model,
		brand: modelBrand(leader.model),
		score: leader.score,
		evidence: leader.evidence,
		evidenceLabel: evidence[leader.evidence],
	})),
}));
const publicBoardPayload = boardPayload.filter((board) => board.leaders.length > 0);
const hasPublicResults = publicBoardPayload.length > 0;
const featuredBoardPayload = publicBoardPayload;
const previewModelNames = [...new Set(publicBoardPayload.flatMap((board) => board.leaders.map((leader) => leader.model)))];
const previewModels = previewModelNames
	.map((model) => {
		const ranks = publicBoardPayload
			.map((board) => board.leaders.find((leader) => leader.model === model)?.rank)
			.filter((rank): rank is number => Number.isFinite(rank));
		return {
			model,
			coverage: ranks.length,
			averageRank: ranks.reduce((sum, rank) => sum + rank, 0) / Math.max(1, ranks.length),
		};
	})
	.sort((a, b) => a.averageRank - b.averageRank || b.coverage - a.coverage || a.model.localeCompare(b.model));
const initialBoard = publicBoardPayload[0];
const initialVisibleLeaders = initialBoard?.leaders.slice(0, 8) || [];
const initialDefaultModelNames = new Set(initialVisibleLeaders.map((leader) => leader.model));

