{
  "name": "lens-frontier-site",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "clean:astro": "rm -rf .astro node_modules/.astro dist",
    "build": "astro build && node scripts/write-legacy-base-redirects.mjs",
    "check:markdown": "markdownlint-cli2",
    "check:content": "node scripts/check-content.mjs",
    "check:bench": "tsx scripts/check-benchmark-data.ts",
    "check:sensitive": "node scripts/check-sensitive-content.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:types": "astro check",
    "check:dist": "node scripts/check-dist.mjs",
    "check:worker": "node --check workers/pageviews/worker.js && node scripts/check-pageview-worker.mjs",
    "check:analytics": "node scripts/check-analytics-smoke.mjs",
    "check:syntax": "node scripts/run-checks.mjs syntax",
    "check:quality": "node scripts/run-checks.mjs quality",
    "images:check": "node scripts/optimize-images.mjs --check",
    "images:optimize": "node scripts/optimize-images.mjs --write",
    "check": "node scripts/run-checks.mjs all",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@lobehub/icons-static-svg": "^1.93.0",
    "astro": "^6.3.3",
    "echarts": "^6.1.0",
    "mermaid": "11.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "cheerio": "^1.2.0",
    "markdownlint-cli2": "^0.22.1",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  }
}
